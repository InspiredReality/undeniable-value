# ─── Postgres (optional — enables cross-session history) ──────────────────────
# Get this from Railway: your project → Postgres service → Connect tab
DATABASE_URL=postgresql://user:password@host:port/dbname

# ─── Anthropic (production default) ───────────────────────────────────────────
# Used when LLM_BASE_URL is not set.
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Local LLM via Ollama (overrides Anthropic when set) ──────────────────────
#
# LOCAL DEV  → set to http://localhost:11434/v1
# VERCEL     → expose your local Ollama via a tunnel, then set to the tunnel URL
#
#   Tunnel setup (one-time):
#     1. Allow external connections:  OLLAMA_ORIGINS=* ollama serve
#     2. Create tunnel:               ngrok http 11434
#     3. Copy the https URL ngrok gives you, e.g. https://abc123.ngrok-free.app
#     4. Set LLM_BASE_URL=https://abc123.ngrok-free.app/v1  (in Vercel dashboard)
#
LLM_BASE_URL=
LLM_MODEL=llama3.2

# Only needed if your Ollama instance requires a key (default: none required)
# LLM_API_KEY=
